{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "labels": [
        "linting"
      ],
      "matchPackageNames": [
        "/eslint/"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "optional"
      ]
    }
  ]
}
